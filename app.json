{
  "expo": {
    "name": "قورئان",
    "slug": "quran-kurdish",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "qurankurdish",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EFE7DC"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.imanikurd.quran",
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "NSLocationWhenInUseUsageDescription": "شوێن بۆ دیاریکردنی کاتی نوێژ و ئاراستەی قیبلە بەکاردەهێنرێت.",
        "NSMotionUsageDescription": "پێوەری مقناتیسی بۆ دیاریکردنی ئاراستەی قیبلە بەکاردەهێنرێت."
      }
    },
    "android": {
      "package": "com.imanikurd.quran",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EFE7DC"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "شوێن بۆ دیاریکردنی کاتی نوێژ و ئاراستەی قیبلە بەکاردەهێنرێت."
        }
      ],
      "expo-sensors",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
